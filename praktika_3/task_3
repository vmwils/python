# запрос чисел у пользователя
num1_str = input("введите первое число: ")
num2_str = input("введите второе число: ")

# преобразование строк в целые числа
num1 = int(num1_str)
num2 = int(num2_str)

# сложение чисел
resilt = num1 + num2
print("сумма чисел:", resilt)

#5*. функция int() может преобразовывать в число только целые строки, а буквы или числа с точкой она обработатьне может

try:
    num1 = int(input("введите первое число: "))
    num2 = int(input("введите второе число: "))
    print("сумма чисел:", num1 + num2)
except ValueError:
    print("ошибка, вводить только целые числа")
